{
  "name": "ai-game-lab",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "A lightweight home for AI-made JavaScript game demos.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs --preview",
    "check": "node scripts/check.mjs && node scripts/test.mjs",
    "new:game": "node scripts/new-game.mjs",
    "test:display": "node scripts/lab-upgrade-qa.mjs",
    "test:experience": "node scripts/play-experience-qa.mjs",
    "test:fps:browser": "node scripts/fps-browser-qa.mjs --regression-only",
    "test:racing:browser": "node scripts/racing-browser-qa.mjs",
    "online:start": "node scripts/racing-server.mjs"
  },
  "dependencies": {
    "three": "0.180.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
